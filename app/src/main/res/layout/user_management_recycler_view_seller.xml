<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    android:backgroundTint="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- User/Vendor Profile Image -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_profile_image_seller"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:src="@tools:sample/avatars"
            android:contentDescription="Profile image" />

        <!-- User Name (e.g., Spacy fresh crab) -->
        <TextView
            android:id="@+id/tv_user_name_seller"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/black"
            app:layout_constraintStart_toEndOf="@+id/iv_profile_image_seller"
            app:layout_constraintTop_toTopOf="@+id/iv_profile_image_seller"
            app:layout_constraintEnd_toStartOf="@+id/btn_view_profile"
            tools:text="Spacy fresh crab" />

        <!-- Subtitle (e.g., by Sifat) -->
        <TextView
            android:id="@+id/tv_user_subtitle_seller"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textSize="16sp"
            android:textColor="#808080"
            app:layout_constraintStart_toEndOf="@+id/iv_profile_image_seller"
            app:layout_constraintTop_toBottomOf="@+id/tv_user_name_seller"
            app:layout_constraintEnd_toStartOf="@+id/btn_view_profile"
            tools:text="by Sifat" />

        <!-- View Profile Button -->
        <Button
            android:id="@+id/btn_view_profile"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="View Profile"
            android:textSize="14dp"
            android:textColor="@android:color/white"
            android:backgroundTint="#FF8C00"
            android:paddingHorizontal="16dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            app:cornerRadius="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>